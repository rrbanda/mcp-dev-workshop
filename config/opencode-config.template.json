{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "__PROVIDER_NAME__": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "__PROVIDER_DISPLAY_NAME__",
      "options": {
        "baseURL": "__BASE_URL__"
      },
      "models": {
        "__MODEL_ID__": {
          "name": "__MODEL_DISPLAY_NAME__",
          "limit": {
            "context": __CONTEXT_WINDOW__,
            "output": __MAX_OUTPUT_TOKENS__
          }
        }
      }
    }
  },
  "model": "__PROVIDER_NAME__/__MODEL_ID__",
  "permission": "allow",
  "default_agent": "code",
  "agent": {
    "code": {
      "prompt": "",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "skill": true,
        "task": true,
        "todowrite": true,
        "todoread": true,
        "question": true,
        "webfetch": false,
        "websearch": false,
        "lsp": false
      }
    }
  }
}
